<Project>

  <!-- Shared settings for every benchmark .csproj in this repository. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- An unreachable package feed must not break the build. -->
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
    <!-- Default to Release so benchmark timings reflect optimized builds. This applies when building or running a single project. A build of the solution defaults to Debug, so use `dotnet build -c Release`. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <!--
    Every benchmark depends on the OptalCP managed API plus the preview
    solver binary. `OptalCP.Bin.Preview` transitively brings in OptalCP at a
    matching version and copies the native `optalcp` executable next to the
    built assembly. Preview edition reports objective values but not
    individual variable values; replace with `OptalCP.Bin` or
    `OptalCP.Bin.Academic` for full functionality.
  -->
  <ItemGroup>
    <PackageReference Include="OptalCP.Bin.Preview" Version="2026.11.0" />
  </ItemGroup>

</Project>
