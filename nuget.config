<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="ScheduleOpt" value="https://nuget.pkg.github.com/ScheduleOpt/index.json" protocolVersion="3" />
  </packageSources>
  <!-- ScheduleOpt hosts the preview solver binary package. GitHub Packages
       requires a personal access token (read:packages). See README.md for
       the one-time credential setup. -->
</configuration>
